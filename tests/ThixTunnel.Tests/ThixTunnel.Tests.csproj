<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the business layer and of the UI, rendered headless with Avalonia + Skia (UiTests: the real windows and pages
    on MatDesktop, driven like a user would; THIXTUNNEL_SCREENSHOTS=<folder> keeps the pictures of the snapshot test).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThixTunnel\ThixTunnel.csproj" />
    <ProjectReference Include="..\..\src\ThixTunnel.Core\ThixTunnel.Core.csproj" />
  </ItemGroup>

</Project>
