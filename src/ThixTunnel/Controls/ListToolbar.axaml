<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ThixTunnel.Controls.ListToolbar"
             Margin="0,0,0,10">
  <!-- The toolbar above every list: search text, filter, sort field and direction.
       Wide: one row. Narrow (small windows): search on top, filter and sort below. -->
  <Grid x:Name="Layout" ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">

    <TextBox x:Name="SearchBox" Watermark="Suchen" ToolTip.Tip="Suchen" AutomationProperties.Name="Suchen">
      <TextBox.InnerLeftContent>
        <TextBlock Text="{StaticResource IconSearch}" FontFamily="{StaticResource IconFont}" FontSize="16"
                   Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
      </TextBox.InnerLeftContent>
    </TextBox>

    <DockPanel x:Name="FilterArea" Grid.Column="1" Margin="12,0,0,0">
      <TextBlock DockPanel.Dock="Left" Text="{StaticResource IconFilter}" FontFamily="{StaticResource IconFont}" FontSize="16"
                 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="Filter" />
      <ComboBox x:Name="FilterBox" MinWidth="150" MinHeight="36" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" ToolTip.Tip="Filter" AutomationProperties.Name="Filter" />
    </DockPanel>

    <DockPanel x:Name="SortArea" Grid.Column="2" Margin="12,0,0,0">
      <TextBlock DockPanel.Dock="Left" Text="{StaticResource IconSort}" FontFamily="{StaticResource IconFont}" FontSize="16"
                 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="Sortierung" />
      <ComboBox x:Name="SortBox" MinWidth="140" MinHeight="36" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" ToolTip.Tip="Sortieren nach" AutomationProperties.Name="Sortieren nach" />
    </DockPanel>

    <Button x:Name="DirectionButton" Grid.Column="3" Theme="{StaticResource IconButton}" Margin="6,0,0,0" MinHeight="36"
            Content="{StaticResource IconUp}" ToolTip.Tip="Aufsteigend" AutomationProperties.Name="Sortierrichtung" />
  </Grid>
</UserControl>
