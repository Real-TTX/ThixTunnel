<UserControl x:Class="ThixTunnel.Controls.ListToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,10" SizeChanged="OnSizeChanged">
  <!-- The toolbar above every list: search text, filter, sort field and direction.
       Wide: one row. Narrow (small windows): search on top, filter and sort below. -->
  <Grid x:Name="Layout">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="SearchArea">
      <TextBox x:Name="SearchBox" Padding="34,7,10,7" TextChanged="OnSearchChanged" ToolTip="Suchen" />
      <TextBlock Text="{StaticResource IconSearch}" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextMutedBrush}"
                 Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      <TextBlock x:Name="Placeholder" Text="Suchen" Style="{StaticResource MutedText}" FontSize="14"
                 Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>

    <DockPanel x:Name="FilterArea" Grid.Column="1">
      <TextBlock DockPanel.Dock="Left" Text="{StaticResource IconFilter}" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextMutedBrush}"
                 VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Filter" />
      <ComboBox x:Name="FilterBox" DisplayMemberPath="Label" SelectionChanged="OnSelectionChanged" ToolTip="Filter" />
    </DockPanel>

    <DockPanel x:Name="SortArea" Grid.Column="2">
      <TextBlock DockPanel.Dock="Left" Text="{StaticResource IconSort}" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextMutedBrush}"
                 VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Sortierung" />
      <ComboBox x:Name="SortBox" DisplayMemberPath="Label" SelectionChanged="OnSelectionChanged" ToolTip="Sortieren nach" />
    </DockPanel>

    <Button x:Name="DirectionButton" Grid.Column="3" Style="{StaticResource IconButton}" Margin="6,0,0,0" MinHeight="34"
            Content="{StaticResource IconUp}" Click="OnDirectionClick" ToolTip="Aufsteigend" />
  </Grid>
</UserControl>
