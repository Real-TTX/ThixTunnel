<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ThixTunnel.Controls"
             x:Class="ThixTunnel.Pages.TunnelListPage">
  <!-- The connection list of the main window, shaped like a contact list: one line per connection with its status dot.
       Only connecting and disconnecting happen here; managing the connections is a tab of the settings window. -->
  <DockPanel>
    <controls:InfoBar x:Name="MessageBar" DockPanel.Dock="Top" Margin="0,0,0,10" />

    <Grid>
      <ListBox x:Name="RouteList" Theme="{StaticResource TableList}" ItemContainerTheme="{StaticResource ContactRow}"
               DoubleTapped="OnRowDoubleTapped" KeyDown="OnListKeyDown">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding Details}" ToolTip.ShowDelay="600">
              <Ellipse Width="11" Height="11" Fill="{Binding DotBrush}" Margin="2,0,12,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Theme="{StaticResource FlatIconButton}" Margin="6,0,0,0" Click="OnRowActionClick" Tag="{Binding Id}"
                      Content="{Binding ActionIcon}" Foreground="{Binding ActionBrush}" ToolTip.Tip="{Binding ActionText}"
                      AutomationProperties.Name="{Binding ActionText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Theme="{StaticResource MutedText}" Margin="10,12" IsVisible="False" VerticalAlignment="Top" />
    </Grid>
  </DockPanel>
</UserControl>
