<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ThixTunnel.Controls"
             x:Class="ThixTunnel.Pages.ProfileEditPage">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <controls:ActionBar>
        <Button x:Name="SaveButton" Theme="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True">
          <controls:IconLabel Icon="{StaticResource IconSave}" Text="Speichern" />
        </Button>
        <Button Click="OnBackClick" IsCancel="True">
          <controls:IconLabel Icon="{StaticResource IconBack}" Text="Zurück" />
        </Button>
        <Button x:Name="DeleteButton" Theme="{StaticResource DangerButton}" controls:ActionBar.Separated="True" Click="OnDeleteClick">
          <controls:IconLabel Icon="{StaticResource IconDelete}" Text="Löschen" />
        </Button>
      </controls:ActionBar>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Form" Margin="20,16,20,20">
        <controls:PageHeader x:Name="Header" Title="SSH-Profil bearbeiten" />
        <controls:InfoBar x:Name="MessageBar" />

        <TabControl x:Name="Tabs">
          <TabItem AutomationProperties.Name="Allgemein">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconProfile}" Text="Allgemein" />
            </TabItem.Header>
            <Border Theme="{StaticResource Tile}">
              <Grid ColumnDefinitions="3*,20,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <controls:FormField Grid.ColumnSpan="3" Header="Name" Field="Name" Hint="So erscheint das Profil in Routen, z. B. „Gateway“ oder „Datenbankserver“.">
                  <TextBox x:Name="NameBox" AutomationProperties.Name="Name" />
                </controls:FormField>
                <controls:FormField Grid.Row="1" Header="Server (Hostname oder IP-Adresse)" Field="HostName">
                  <TextBox x:Name="HostBox" AutomationProperties.Name="Server" />
                </controls:FormField>
                <controls:FormField Grid.Row="1" Grid.Column="2" Header="SSH-Port" Field="Port">
                  <TextBox x:Name="PortBox" AutomationProperties.Name="SSH-Port" />
                </controls:FormField>
                <controls:FormField Grid.Row="2" Header="Benutzer" Field="UserName">
                  <TextBox x:Name="UserBox" AutomationProperties.Name="Benutzer" />
                </controls:FormField>
                <controls:FormField Grid.Row="3" Grid.ColumnSpan="3" Header="Beschreibung (optional)" Field="Description">
                  <TextBox x:Name="DescriptionBox" AutomationProperties.Name="Beschreibung" />
                </controls:FormField>
              </Grid>
            </Border>
          </TabItem>

          <TabItem AutomationProperties.Name="Authentifizierung">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconKey}" Text="Authentifizierung" />
            </TabItem.Header>
            <StackPanel>
              <Border Theme="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="Anmeldeverfahren" Theme="{StaticResource SectionTitle}" />
                  <RadioButton x:Name="AgentOption" Theme="{StaticResource OptionRadio}" GroupName="Auth" AutomationProperties.Name="SSH-Agent / Standardschlüssel">
                    <StackPanel>
                      <TextBlock Text="SSH-Agent / Standardschlüssel" TextWrapping="Wrap" />
                      <TextBlock x:Name="AgentDescription" Theme="{StaticResource MutedText}" />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="KeyFileOption" Theme="{StaticResource OptionRadio}" GroupName="Auth" AutomationProperties.Name="Bestimmte Schlüsseldatei">
                    <StackPanel>
                      <TextBlock Text="Bestimmte Schlüsseldatei" TextWrapping="Wrap" />
                      <TextBlock Theme="{StaticResource MutedText}" Text="Nur dieser private Schlüssel wird verwendet. Eine Passphrase wird beim manuellen Verbinden abgefragt." />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="PasswordOption" Theme="{StaticResource OptionRadio}" GroupName="Auth" AutomationProperties.Name="Passwort">
                    <StackPanel>
                      <TextBlock Text="Passwort" TextWrapping="Wrap" />
                      <TextBlock Theme="{StaticResource MutedText}" Text="Wird bei jedem manuellen Verbinden abgefragt und nicht gespeichert. Für automatische Verbindungen: unten einen Schlüssel anlegen lassen." />
                    </StackPanel>
                  </RadioButton>
                </StackPanel>
              </Border>

              <!-- Only for the password method -->
              <Border x:Name="KeySetupTile" Theme="{StaticResource Tile}" Padding="20,4">
                <controls:SettingToggle x:Name="KeySetupToggle" BorderThickness="0" Title="Beim ersten Anmelden einen Schlüssel anlegen und hinterlegen"
                                        Description="Beim nächsten manuellen Verbinden fragt ThixTunnel einmal nach dem Passwort, erzeugt einen eigenen Schlüssel und trägt ihn auf dem Server in ~/.ssh/authorized_keys ein. Danach verbindet das Profil ohne Passwort – auch automatisch. Nur für Linux-/Unix-Server." />
              </Border>

              <!-- Only for the key file method -->
              <Border x:Name="KeyFileTile" Theme="{StaticResource Tile}">
                <controls:FormField x:Name="KeyFileField" Header="Private Schlüsseldatei" Field="KeyFilePath" Margin="0">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnBrowseKeyClick">
                      <controls:IconLabel Icon="{StaticResource IconFolder}" Text="Durchsuchen …" />
                    </Button>
                    <TextBox x:Name="KeyFileBox" AutomationProperties.Name="Private Schlüsseldatei" />
                  </DockPanel>
                </controls:FormField>
              </Border>
            </StackPanel>
          </TabItem>
        </TabControl>

        <TextBlock x:Name="UsageText" Theme="{StaticResource MutedText}" Margin="0,4,0,0" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
