<UserControl x:Class="ThixTunnel.Pages.RouteListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThixTunnel.Controls">
  <!-- Managing the connections (tunnel routes): a tab of the settings window. The main window only connects and disconnects. -->
  <DockPanel>
    <controls:ListToolbar x:Name="Toolbar" DockPanel.Dock="Top" SearchPlaceholder="Verbindungen suchen" />
    <controls:InfoBar x:Name="MessageBar" DockPanel.Dock="Top" Margin="0,0,0,10" />

    <!-- Actions below the list: positive to negative, delete separated -->
    <controls:ActionBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button Style="{StaticResource PrimaryButton}" Click="OnNewClick">
        <controls:IconLabel Icon="{StaticResource IconAdd}" Text="Neue Verbindung" />
      </Button>
      <Button x:Name="EditButton" Click="OnEditClick">
        <controls:IconLabel Icon="{StaticResource IconEdit}" Text="Bearbeiten" />
      </Button>
      <Button x:Name="CopyButton" Click="OnCopyCommandClick">
        <controls:IconLabel Icon="{StaticResource IconCopy}" Text="ssh-Befehl kopieren" />
      </Button>
      <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" controls:ActionBar.Separated="True" Click="OnDeleteClick">
        <controls:IconLabel Icon="{StaticResource IconDelete}" Text="Löschen" />
      </Button>
    </controls:ActionBar>

    <Border Style="{StaticResource Tile}" Padding="6" Margin="0">
      <Grid>
        <ListBox x:Name="RouteList" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource ContactRow}"
                 SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Details}" ToolTipService.InitialShowDelay="600">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" Margin="4,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Endpoints}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Chain}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding AutomationText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="10,0,4,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Margin="10,10" Visibility="Collapsed" VerticalAlignment="Top" />
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
