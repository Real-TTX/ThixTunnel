<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ThixTunnel.Controls"
             x:Class="ThixTunnel.Pages.SettingsPage">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <controls:ActionBar>
        <Button x:Name="SaveButton" Theme="{StaticResource PrimaryButton}" Click="OnSaveClick">
          <controls:IconLabel Icon="{StaticResource IconSave}" Text="Speichern" />
        </Button>
        <Button Click="OnBackClick">
          <controls:IconLabel Icon="{StaticResource IconBack}" Text="Zurück" />
        </Button>
      </controls:ActionBar>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Form" Margin="20,16,20,20">
        <controls:PageHeader Title="Einstellungen" />
        <controls:InfoBar x:Name="MessageBar" />

        <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
          <TabItem AutomationProperties.Name="Start und Verhalten">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconSettings}" Text="Start und Verhalten" />
            </TabItem.Header>
            <StackPanel>
              <Border Theme="{StaticResource Tile}" Padding="20,4">
                <StackPanel>
                  <controls:SettingToggle x:Name="StartWithWindowsToggle" Title="Bei der Anmeldung starten" Description="Für dein Benutzerkonto" />
                  <controls:SettingToggle x:Name="StartInTrayToggle" Title="Unsichtbar starten" Description="Beim automatischen Start nur das Symbol im Infobereich / in der Menüleiste zeigen" />
                  <controls:SettingToggle x:Name="KeepRunningToggle" Title="Beim Schließen im Hintergrund weiterlaufen" Description="Tunnel bleiben aktiv; „Beenden“ im Menü des Symbols trennt alle Tunnel" />
                  <controls:SettingToggle x:Name="NotifyToggle" Title="Bei Verbindungsfehlern benachrichtigen" Description="Kurzer Hinweis am Bildschirmrand" BorderThickness="0" />
                </StackPanel>
              </Border>
              <controls:InfoBar x:Name="AutoConnectInfo" />
            </StackPanel>
          </TabItem>

          <!-- Connections: created, changed and deleted only here -->
          <TabItem AutomationProperties.Name="Verbindungen">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconTunnel}" Text="Verbindungen" />
            </TabItem.Header>
            <ContentControl x:Name="RoutesHost" Focusable="False" />
          </TabItem>

          <!-- SSH profiles: managed here, not in the connection list -->
          <TabItem AutomationProperties.Name="SSH-Profile">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconProfile}" Text="SSH-Profile" />
            </TabItem.Header>
            <ContentControl x:Name="ProfilesHost" Focusable="False" />
          </TabItem>

          <!-- Import / export of profiles and connections -->
          <TabItem AutomationProperties.Name="Import / Export">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconExport}" Text="Import / Export" />
            </TabItem.Header>
            <StackPanel>
              <controls:InfoBar x:Name="TransferResult" />
              <Border Theme="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="Exportieren" Theme="{StaticResource SectionTitle}" />
                  <TextBlock Theme="{StaticResource MutedText}" Margin="0,-4,0,14"
                             Text="Speichert alle SSH-Profile und Verbindungen in einer Datei – für den Umzug auf einen anderen Rechner, zum Teilen oder als Sicherung. Passwörter werden nie gespeichert, Schlüsseldateien nur als Pfad." />
                  <controls:ActionBar>
                    <Button x:Name="ExportButton" Theme="{StaticResource PrimaryButton}" Click="OnExportClick">
                      <controls:IconLabel Icon="{StaticResource IconExport}" Text="Exportieren …" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>
              </Border>
              <Border Theme="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="Importieren" Theme="{StaticResource SectionTitle}" />
                  <TextBlock Theme="{StaticResource MutedText}" Margin="0,-4,0,6"
                             Text="Übernimmt SSH-Profile und Verbindungen aus einer Exportdatei. Vorhandene Einträge (gleiche ID oder gleicher Name) bleiben unverändert – außer du wählst „Vorhandene ersetzen“." />
                  <controls:SettingToggle x:Name="ReplaceExistingToggle" Title="Vorhandene ersetzen" BorderThickness="0" Margin="0,0,0,8"
                                          Description="Gleichnamige Profile und Verbindungen mit den Angaben aus der Datei überschreiben" />
                  <controls:ActionBar>
                    <Button x:Name="ImportButton" Click="OnImportClick">
                      <controls:IconLabel Icon="{StaticResource IconImport}" Text="Importieren …" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>

          <TabItem AutomationProperties.Name="Updates">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconDownload}" Text="Updates" />
            </TabItem.Header>
            <StackPanel>
              <Border Theme="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="Installierte Version" Theme="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="VersionText" FontSize="15" />
                  <TextBlock x:Name="ChannelText" Theme="{StaticResource MutedText}" Margin="0,4,0,14" />
                  <controls:InfoBar x:Name="UpdateStatus" Margin="0,0,0,12" />
                  <ProgressBar x:Name="DownloadProgress" Height="4" MinHeight="4" Minimum="0" Maximum="1" Margin="0,0,0,12" IsVisible="False"
                               Foreground="{StaticResource AccentBrush}" Background="{StaticResource InputBrush}" />
                  <controls:ActionBar>
                    <Button x:Name="CheckButton" Click="OnCheckClick">
                      <controls:IconLabel Icon="{StaticResource IconRefresh}" Text="Jetzt prüfen" />
                    </Button>
                    <Button x:Name="InstallButton" Theme="{StaticResource PrimaryButton}" Click="OnInstallClick" IsVisible="False">
                      <controls:IconLabel Icon="{StaticResource IconDownload}" Text="Update installieren" />
                    </Button>
                    <Button x:Name="ReleasePageButton" Theme="{StaticResource LinkButton}" Click="OnReleasePageClick" Padding="8,0">
                      <TextBlock Text="Versionshinweise auf GitHub" VerticalAlignment="Center" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>
              </Border>
              <Border x:Name="UpdateOptionsTile" Theme="{StaticResource Tile}" Padding="20,4">
                <StackPanel>
                  <controls:SettingToggle x:Name="CheckUpdatesToggle" Title="Automatisch nach Updates suchen" Description="Beim Start und alle 6 Stunden" />
                  <controls:SettingToggle x:Name="AutoInstallToggle" Title="Updates automatisch installieren" BorderThickness="0"
                                          Description="Voll-automatisches Update: ThixTunnel installiert neue Versionen selbst und startet neu. Aktive Tunnel werden danach wieder verbunden." />
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>

          <TabItem AutomationProperties.Name="Erweitert">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconKey}" Text="Erweitert" />
            </TabItem.Header>
            <StackPanel>
              <Border Theme="{StaticResource Tile}">
                <StackPanel>
                  <controls:FormField x:Name="SshPathField" Header="ssh-Programm (optional)" Field="SshExecutablePath">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnBrowseSshClick">
                        <controls:IconLabel Icon="{StaticResource IconFolder}" Text="Durchsuchen …" />
                      </Button>
                      <TextBox x:Name="SshPathBox" AutomationProperties.Name="ssh-Programm" />
                    </DockPanel>
                  </controls:FormField>
                  <controls:ActionBar>
                    <Button Click="OnOpenDataFolderClick">
                      <controls:IconLabel Icon="{StaticResource IconFolder}" Text="Datenordner öffnen" />
                    </Button>
                    <Button Click="OnOpenLogFolderClick">
                      <controls:IconLabel Icon="{StaticResource IconFolder}" Text="Protokolle öffnen" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>
              </Border>
              <Border Theme="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="Richtlinien" Theme="{StaticResource SectionTitle}" />
                  <SelectableTextBlock x:Name="PolicyText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
