<UserControl x:Class="ThixTunnel.Pages.ProfileListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThixTunnel.Controls">
  <DockPanel x:Name="Root" Margin="20,16,20,16">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="SSH-Profile" Subtitle="Anmeldungen an SSH-Servern – ein Profil kann in vielen Verbindungen stecken" />
    <controls:ListToolbar x:Name="Toolbar" DockPanel.Dock="Top" SearchPlaceholder="Profile suchen" />
    <controls:InfoBar x:Name="MessageBar" DockPanel.Dock="Top" Margin="0,0,0,10" />

    <!-- Actions below the list: positive to negative, delete separated -->
    <controls:ActionBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button Style="{StaticResource PrimaryButton}" Click="OnNewClick">
        <controls:IconLabel Icon="{StaticResource IconAdd}" Text="Neues Profil" />
      </Button>
      <Button x:Name="EditButton" Click="OnEditClick">
        <controls:IconLabel Icon="{StaticResource IconEdit}" Text="Bearbeiten" />
      </Button>
      <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" controls:ActionBar.Separated="True" Click="OnDeleteClick">
        <controls:IconLabel Icon="{StaticResource IconDelete}" Text="Löschen" />
      </Button>
    </controls:ActionBar>

    <Border Style="{StaticResource Tile}" Padding="6" Margin="0">
      <Grid>
        <ListBox x:Name="ProfileList" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource ContactRow}"
                 SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Details}" ToolTipService.InitialShowDelay="600">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding AuthenticationIcon}" FontFamily="{StaticResource IconFont}" FontSize="15"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,12,0" ToolTip="{Binding Authentication}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Login}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Usage}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="10,0,4,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Margin="10,10" Visibility="Collapsed" VerticalAlignment="Top" />
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
