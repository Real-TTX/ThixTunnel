<UserControl x:Class="ThixTunnel.Pages.ProfileListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThixTunnel.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,24">
      <controls:PageHeader Title="SSH-Profile" Subtitle="Anmeldungen an SSH-Servern – ein Profil kann in vielen Tunnelrouten stecken" />
      <controls:InfoBar x:Name="MessageBar" />
      <controls:ListToolbar x:Name="Toolbar" SearchPlaceholder="Profile suchen" />

      <Border Style="{StaticResource Tile}" Padding="0" Margin="0">
        <StackPanel>
          <Grid Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Profil" Style="{StaticResource TableHeaderText}" />
            <TextBlock Grid.Column="1" Text="Server" Style="{StaticResource TableHeaderText}" />
            <TextBlock Grid.Column="2" Text="Benutzer" Style="{StaticResource TableHeaderText}" />
            <TextBlock Grid.Column="3" Text="Anmeldung" Style="{StaticResource TableHeaderText}" />
            <TextBlock Grid.Column="4" Text="Verwendet" Style="{StaticResource TableHeaderText}" />
          </Grid>
          <ListBox x:Name="ProfileList" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource TableRow}"
                   SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="40">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="110" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Server}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding UserName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AuthenticationIcon}" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Authentication}" />
                  </StackPanel>
                  <TextBlock Grid.Column="4" Text="{Binding Usage}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Margin="16,14,16,16" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <controls:ActionBar Margin="0,14,0,20">
        <Button Style="{StaticResource PrimaryButton}" Click="OnNewClick">
          <controls:IconLabel Icon="{StaticResource IconAdd}" Text="Neues Profil" />
        </Button>
        <Button x:Name="EditButton" Click="OnEditClick">
          <controls:IconLabel Icon="{StaticResource IconEdit}" Text="Bearbeiten" />
        </Button>
        <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" controls:ActionBar.Separated="True" Click="OnDeleteClick">
          <controls:IconLabel Icon="{StaticResource IconDelete}" Text="Löschen" />
        </Button>
      </controls:ActionBar>
    </StackPanel>
  </ScrollViewer>
</UserControl>
