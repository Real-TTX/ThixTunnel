<UserControl x:Class="ThixTunnel.Pages.TunnelListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThixTunnel.Controls">
  <!-- The connection list of the main window, shaped like a contact list: one line per connection with its status dot.
       Only connecting and disconnecting happen here; managing the connections is a tab of the settings window. -->
  <DockPanel>
    <controls:InfoBar x:Name="MessageBar" DockPanel.Dock="Top" Margin="0,0,0,10" />

    <Grid>
      <ListBox x:Name="RouteList" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource ContactRow}"
               MouseDoubleClick="OnRowDoubleClick" KeyDown="OnListKeyDown">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ToolTip="{Binding Details}" ToolTipService.InitialShowDelay="600">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Ellipse Width="11" Height="11" Fill="{Binding DotBrush}" Margin="2,0,12,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Style="{StaticResource FlatIconButton}" Margin="6,0,0,0" Click="OnRowActionClick" Tag="{Binding Id}"
                      Content="{Binding ActionIcon}" Foreground="{Binding ActionBrush}" ToolTip="{Binding ActionText}"
                      AutomationProperties.Name="{Binding ActionText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Margin="10,12" Visibility="Collapsed" VerticalAlignment="Top" />
    </Grid>
  </DockPanel>
</UserControl>
