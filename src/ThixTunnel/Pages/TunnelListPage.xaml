<UserControl x:Class="ThixTunnel.Pages.TunnelListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThixTunnel.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,24">
      <controls:PageHeader Title="Tunnel" Subtitle="Gespeicherte Verbindungen" />
      <controls:InfoBar x:Name="MessageBar" />
      <controls:ListToolbar x:Name="Toolbar" SearchPlaceholder="Tunnel suchen" />

      <!-- Table -->
      <Border Style="{StaticResource Tile}" Padding="0" Margin="0">
        <StackPanel>
          <Grid Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tunnel" Style="{StaticResource TableHeaderText}" />
            <TextBlock Grid.Column="1" Text="Lokal" Style="{StaticResource TableHeaderText}" />
            <TextBlock Grid.Column="2" Text="Ziel" Style="{StaticResource TableHeaderText}" />
            <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource TableHeaderText}" />
          </Grid>
          <ListBox x:Name="RouteList" Style="{StaticResource TableList}" ItemContainerStyle="{StaticResource TableRow}"
                   SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Chain}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Local}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Target}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                  <controls:StatusBadge Grid.Column="3" Status="{Binding Status}" />
                  <Button Grid.Column="4" Click="OnRowActionClick" Tag="{Binding Id}" HorizontalAlignment="Stretch"
                          Style="{Binding ActionStyle}">
                    <controls:IconLabel Icon="{Binding ActionIcon}" Text="{Binding ActionText}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Margin="16,14,16,16" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- Actions below the list: positive to negative, delete separated -->
      <controls:ActionBar Margin="0,14,0,20">
        <Button Style="{StaticResource PrimaryButton}" Click="OnNewClick">
          <controls:IconLabel Icon="{StaticResource IconAdd}" Text="Neue Tunnelroute" />
        </Button>
        <Button x:Name="EditButton" Click="OnEditClick">
          <controls:IconLabel Icon="{StaticResource IconEdit}" Text="Bearbeiten" />
        </Button>
        <Button x:Name="DisconnectAllButton" Click="OnDisconnectAllClick">
          <controls:IconLabel Icon="{StaticResource IconDisconnect}" Text="Alle trennen" />
        </Button>
        <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" controls:ActionBar.Separated="True" Click="OnDeleteClick">
          <controls:IconLabel Icon="{StaticResource IconDelete}" Text="Löschen" />
        </Button>
      </controls:ActionBar>

      <!-- Details of the selected route -->
      <Border x:Name="DetailsTile" Style="{StaticResource Tile}" Padding="24,20" Visibility="Collapsed">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="15" Click="OnEditClick">
              <controls:IconLabel Icon="{StaticResource IconEdit}" Text="Bearbeiten" />
            </Button>
            <TextBlock x:Name="DetailsTitle" FontSize="22" FontWeight="SemiBold" />
          </DockPanel>

          <controls:HopChain x:Name="DetailsChain" Margin="0,0,0,12" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:FormField Header="Lokaler Zugriff">
              <TextBox x:Name="DetailsLocal" IsReadOnly="True" />
            </controls:FormField>
            <controls:FormField x:Name="DetailsTargetField" Grid.Column="2" Header="Ziel">
              <TextBox x:Name="DetailsTarget" IsReadOnly="True" />
            </controls:FormField>
          </Grid>

          <WrapPanel Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
              <TextBlock x:Name="AutoConnectIcon" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock x:Name="AutoConnectText" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ReconnectIcon" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock x:Name="ReconnectText" />
            </StackPanel>
          </WrapPanel>

          <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="DetailsStatusDot" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="DetailsStatusText" TextWrapping="Wrap" />
              </StackPanel>
              <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IconCopy}"
                        ToolTip="Befehl kopieren" Click="OnCopyCommandClick" VerticalAlignment="Top" />
                <TextBlock x:Name="DetailsCommand" Style="{StaticResource MonoText}" VerticalAlignment="Center" Margin="0,0,12,0" />
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
