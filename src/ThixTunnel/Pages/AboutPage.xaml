<UserControl x:Class="ThixTunnel.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThixTunnel.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,16,20,20">
      <controls:PageHeader Title="Über ThixTunnel" />

      <Border Style="{StaticResource Tile}" Padding="28,24">
        <DockPanel>
          <Image DockPanel.Dock="Left" Source="/Assets/logo-256.png" Width="96" Height="96" Margin="0,0,28,0" VerticalAlignment="Top"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel>
            <TextBlock FontSize="30" FontWeight="SemiBold">
              <Run Text="Thix" /><Run Text="Tunnel" Foreground="{StaticResource AccentHoverBrush}" />
            </TextBlock>
            <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,16"
                       Text="SSH-Profile, mehrere Hops und lokale Portweiterleitungen als Windows-Tray-App." />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Version" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
              <TextBlock x:Name="VersionText" Grid.Column="1" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Text="Kanal" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
              <TextBlock x:Name="ChannelText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
              <TextBlock Grid.Row="2" Text="ssh" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
              <TextBlock x:Name="SshText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="Daten" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
              <TextBlock x:Name="DataText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Text="Autor" Style="{StaticResource MutedText}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="Matthias Schmoldt" />
            </Grid>
          </StackPanel>
        </DockPanel>
      </Border>

      <controls:ActionBar>
        <Button Style="{StaticResource PrimaryButton}" Click="OnProjectClick">
          <controls:IconLabel Icon="{StaticResource IconArrowRight}" Text="Projekt auf GitHub" />
        </Button>
        <Button Click="OnUpdatesClick">
          <controls:IconLabel Icon="{StaticResource IconDownload}" Text="Updates" />
        </Button>
        <Button Click="OnBackClick">
          <controls:IconLabel Icon="{StaticResource IconBack}" Text="Zurück" />
        </Button>
      </controls:ActionBar>
    </StackPanel>
  </ScrollViewer>
</UserControl>
