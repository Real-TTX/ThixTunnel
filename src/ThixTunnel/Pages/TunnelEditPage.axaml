<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ThixTunnel.Controls"
             x:Class="ThixTunnel.Pages.TunnelEditPage">
  <DockPanel>
    <!-- Buttons: save, back, (gap) delete -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <controls:ActionBar>
        <Button x:Name="SaveButton" Theme="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True">
          <controls:IconLabel Icon="{StaticResource IconSave}" Text="Speichern" />
        </Button>
        <Button x:Name="SaveConnectButton" Click="OnSaveConnectClick">
          <controls:IconLabel Icon="{StaticResource IconConnect}" Text="Speichern und verbinden" />
        </Button>
        <Button Click="OnBackClick" IsCancel="True">
          <controls:IconLabel Icon="{StaticResource IconBack}" Text="Zurück" />
        </Button>
        <Button x:Name="DeleteButton" Theme="{StaticResource DangerButton}" controls:ActionBar.Separated="True" Click="OnDeleteClick">
          <controls:IconLabel Icon="{StaticResource IconDelete}" Text="Löschen" />
        </Button>
      </controls:ActionBar>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Form" Margin="20,16,20,20">
        <controls:PageHeader x:Name="Header" Title="Tunnelroute bearbeiten" />
        <controls:InfoBar x:Name="MessageBar" />

        <TabControl x:Name="Tabs">
          <!-- Tab 1: name and hops -->
          <TabItem AutomationProperties.Name="Route">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconTunnel}" Text="Route" />
            </TabItem.Header>
            <StackPanel>
              <controls:FormField Header="Name" Field="Name">
                <TextBox x:Name="NameBox" AutomationProperties.Name="Name" />
              </controls:FormField>

              <Border Theme="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="SSH-Hops" Theme="{StaticResource SectionTitle}" />
                  <TextBlock Theme="{StaticResource MutedText}" Margin="0,-6,0,14"
                             Text="Die Profile werden in dieser Reihenfolge verbunden. Alle vor dem letzten dienen als Sprungserver." />
                  <controls:FormField Field="HopProfileIds">
                    <StackPanel x:Name="HopList" />
                  </controls:FormField>
                  <controls:ActionBar>
                    <Button x:Name="AddHopButton" Click="OnAddHopClick">
                      <controls:IconLabel Icon="{StaticResource IconAdd}" Text="Hop hinzufügen" />
                    </Button>
                    <Button Click="OnNewProfileClick">
                      <controls:IconLabel Icon="{StaticResource IconProfile}" Text="Neues SSH-Profil …" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>

          <!-- Tab 2: port forwarding -->
          <TabItem AutomationProperties.Name="Portweiterleitung">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconArrowRight}" Text="Portweiterleitung" />
            </TabItem.Header>
            <Border Theme="{StaticResource Tile}">
              <Grid ColumnDefinitions="2*,20,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.ColumnSpan="3" Text="Auf diesem Rechner" Theme="{StaticResource SectionTitle}" />
                <controls:FormField Grid.Row="1" Header="Lokale Adresse" Field="LocalAddress" x:Name="LocalAddressField">
                  <TextBox x:Name="LocalAddressBox" AutomationProperties.Name="Lokale Adresse" />
                </controls:FormField>
                <controls:FormField Grid.Row="1" Grid.Column="2" Header="Lokaler Port" Field="LocalPort">
                  <TextBox x:Name="LocalPortBox" AutomationProperties.Name="Lokaler Port" />
                </controls:FormField>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Ziel" Theme="{StaticResource SectionTitle}" Margin="0,8,0,12" />
                <controls:FormField Grid.Row="3" Header="Zielhost" Field="TargetHost" x:Name="TargetHostField">
                  <TextBox x:Name="TargetHostBox" AutomationProperties.Name="Zielhost" />
                </controls:FormField>
                <controls:FormField Grid.Row="3" Grid.Column="2" Header="Zielport" Field="TargetPort">
                  <TextBox x:Name="TargetPortBox" AutomationProperties.Name="Zielport" />
                </controls:FormField>
              </Grid>
            </Border>
          </TabItem>

          <!-- Tab 3: automation -->
          <TabItem AutomationProperties.Name="Automatisierung">
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconRefresh}" Text="Automatisierung" />
            </TabItem.Header>
            <StackPanel>
              <Border Theme="{StaticResource Tile}" Padding="20,4">
                <StackPanel>
                  <controls:SettingToggle x:Name="ConnectOnStartupToggle" Title="Beim App-Start automatisch verbinden"
                                          Description="Gilt für jeden Start von ThixTunnel – zusammen mit dem Autostart also direkt nach der Anmeldung." />
                  <controls:SettingToggle x:Name="ReconnectToggle" Title="Bei Verbindungsabbruch erneut verbinden" BorderThickness="0"
                                          Description="Wiederholt mit wachsenden Pausen. Manuelles Trennen beendet die Versuche." />
                </StackPanel>
              </Border>
              <controls:InfoBar x:Name="AutomationHint" />
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
