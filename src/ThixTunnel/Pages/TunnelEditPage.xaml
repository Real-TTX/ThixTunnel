<UserControl x:Class="ThixTunnel.Pages.TunnelEditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThixTunnel.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="ProfileItemTemplate">
      <TextBlock Text="{Binding Name}" />
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
    <!-- Buttons: save, back, (gap) delete -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <controls:ActionBar>
        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True">
          <controls:IconLabel Icon="{StaticResource IconSave}" Text="Speichern" />
        </Button>
        <Button x:Name="SaveConnectButton" Click="OnSaveConnectClick">
          <controls:IconLabel Icon="{StaticResource IconConnect}" Text="Speichern und verbinden" />
        </Button>
        <Button Click="OnBackClick" IsCancel="True">
          <controls:IconLabel Icon="{StaticResource IconBack}" Text="Zurück" />
        </Button>
        <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" controls:ActionBar.Separated="True" Click="OnDeleteClick">
          <controls:IconLabel Icon="{StaticResource IconDelete}" Text="Löschen" />
        </Button>
      </controls:ActionBar>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Form" Margin="20,16,20,20">
        <controls:PageHeader x:Name="Header" Title="Tunnelroute bearbeiten" />
        <controls:InfoBar x:Name="MessageBar" />

        <TabControl x:Name="Tabs">
          <!-- Tab 1: name and hops -->
          <TabItem>
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconTunnel}" Text="Route" />
            </TabItem.Header>
            <StackPanel>
              <controls:FormField Header="Name" Field="Name">
                <TextBox x:Name="NameBox" />
              </controls:FormField>

              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="SSH-Hops" Style="{StaticResource SectionTitle}" />
                  <TextBlock Style="{StaticResource MutedText}" Margin="0,-6,0,14"
                             Text="Die Profile werden in dieser Reihenfolge verbunden. Alle vor dem letzten dienen als Sprungserver." />
                  <controls:FormField Field="HopProfileIds">
                    <StackPanel x:Name="HopList" />
                  </controls:FormField>
                  <controls:ActionBar>
                    <Button x:Name="AddHopButton" Click="OnAddHopClick">
                      <controls:IconLabel Icon="{StaticResource IconAdd}" Text="Hop hinzufügen" />
                    </Button>
                    <Button Click="OnNewProfileClick">
                      <controls:IconLabel Icon="{StaticResource IconProfile}" Text="Neues SSH-Profil …" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>

          <!-- Tab 2: port forwarding -->
          <TabItem>
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconArrowRight}" Text="Portweiterleitung" />
            </TabItem.Header>
            <Border Style="{StaticResource Tile}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="Auf diesem PC" Style="{StaticResource SectionTitle}" />
                <controls:FormField Grid.Row="1" Header="Lokale Adresse" Field="LocalAddress" x:Name="LocalAddressField">
                  <TextBox x:Name="LocalAddressBox" TextChanged="OnLocalAddressChanged" />
                </controls:FormField>
                <controls:FormField Grid.Row="1" Grid.Column="2" Header="Lokaler Port" Field="LocalPort">
                  <TextBox x:Name="LocalPortBox" />
                </controls:FormField>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Ziel" Style="{StaticResource SectionTitle}" Margin="0,8,0,12" />
                <controls:FormField Grid.Row="3" Header="Zielhost" Field="TargetHost" x:Name="TargetHostField">
                  <TextBox x:Name="TargetHostBox" />
                </controls:FormField>
                <controls:FormField Grid.Row="3" Grid.Column="2" Header="Zielport" Field="TargetPort">
                  <TextBox x:Name="TargetPortBox" />
                </controls:FormField>
              </Grid>
            </Border>
          </TabItem>

          <!-- Tab 3: automation -->
          <TabItem>
            <TabItem.Header>
              <controls:IconLabel Icon="{StaticResource IconRefresh}" Text="Automatisierung" />
            </TabItem.Header>
            <StackPanel>
              <Border Style="{StaticResource Tile}" Padding="20,4">
                <StackPanel>
                  <controls:SettingToggle x:Name="ConnectOnStartupToggle" Title="Beim App-Start automatisch verbinden"
                                          Description="Gilt für jeden Start von ThixTunnel – zusammen mit dem Windows-Autostart also direkt nach der Anmeldung." />
                  <controls:SettingToggle x:Name="ReconnectToggle" Title="Bei Verbindungsabbruch erneut verbinden" BorderThickness="0"
                                          Description="Wiederholt mit wachsenden Pausen. Manuelles Trennen beendet die Versuche." />
                </StackPanel>
              </Border>
              <controls:InfoBar x:Name="AutomationHint" />
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
