<Window x:Class="ThixTunnel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:ThixTunnel.Pages"
        Title="ThixTunnel" Width="340" Height="620" MinWidth="300" MinHeight="340"
        Icon="Assets/thixtunnel.ico">
  <!-- Narrow and tall like a contact list: the connections. Everything else opens in its own window. -->
  <DockPanel>
    <!-- Head: brand and overall status -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="14,12">
      <DockPanel>
        <Image Source="Assets/logo-256.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="16" FontWeight="SemiBold">
            <Run Text="Thix" /><Run Text="Tunnel" Foreground="{StaticResource AccentHoverBrush}" />
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Margin="7,0,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="Kein Tunnel aktiv" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Foot: version (opens "Über") bottom left, the other windows bottom right -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="10,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="UpdateHint" Style="{StaticResource FlatIconButton}" Content="{StaticResource IconDownload}" Foreground="{StaticResource WarningBrush}"
                  ToolTip="Update verfügbar" AutomationProperties.Name="Update verfügbar" Visibility="Collapsed" Click="OnUpdateHintClick" />
          <Button Style="{StaticResource FlatIconButton}" Content="{StaticResource IconSettings}" ToolTip="Einstellungen"
                  AutomationProperties.Name="Einstellungen" Click="OnSettingsClick" />
        </StackPanel>
        <Button x:Name="VersionLink" Style="{StaticResource LinkButton}" Click="OnVersionClick" ToolTip="Über ThixTunnel"
                AutomationProperties.Name="Über ThixTunnel" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="4,0">
          <TextBlock x:Name="VersionText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Button>
      </DockPanel>
    </Border>

    <pages:TunnelListPage x:Name="Connections" Margin="12,12,12,12" />
  </DockPanel>
</Window>
