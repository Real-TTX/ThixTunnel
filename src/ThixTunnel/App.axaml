<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ThixTunnel.App"
             Name="ThixTunnel"
             RequestedThemeVariant="Default">
  <!--
    The look is MatDesktop's (MatDesktop/, copied from MatDesign): App.Initialize installs its theme with ThixTunnel's accent
    (Fluent in the colours of the tokens, a brush per token in light and dark, the control themes of the flat look, the
    icons of the sprite; every window takes the app's icon from it). ThixTunnel writes no theme of its own (DESK-02).
  -->
</Application>
