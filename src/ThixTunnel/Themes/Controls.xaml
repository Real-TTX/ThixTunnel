<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ThixTunnel.Controls">

  <!-- Look of the code-based controls in ThixTunnel.Controls. -->

  <Style TargetType="controls:FormField">
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:FormField">
          <StackPanel>
            <TextBlock x:Name="HeaderText" Text="{TemplateBinding Header}" Style="{StaticResource FieldLabel}" />
            <ContentPresenter />
            <TextBlock x:Name="HintText" Text="{TemplateBinding Hint}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="{StaticResource IconWarning}" FontFamily="{StaticResource IconFont}" FontSize="12"
                         Foreground="{StaticResource DangerBrush}" Margin="0,2,6,0" VerticalAlignment="Top" />
              <TextBlock Text="{TemplateBinding Error}" Foreground="{StaticResource DangerBrush}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
              <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Hint" Value="">
              <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Error" Value="">
              <Setter TargetName="ErrorPanel" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
