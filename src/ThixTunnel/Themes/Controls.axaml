<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ThixTunnel.Controls">

  <!-- Look of the templated controls in ThixTunnel.Controls. -->

  <ControlTheme x:Key="{x:Type controls:FormField}" TargetType="controls:FormField">
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <TextBlock Name="HeaderText" Text="{TemplateBinding Header}" Theme="{StaticResource FieldLabel}"
                     IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          <TextBlock Name="HintText" Text="{TemplateBinding Hint}" Theme="{StaticResource MutedText}" Margin="0,6,0,0"
                     IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <DockPanel Name="ErrorPanel" Margin="0,6,0,0"
                     IsVisible="{TemplateBinding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock DockPanel.Dock="Left" Text="{StaticResource IconWarning}" FontFamily="{StaticResource IconFont}" FontSize="13"
                       Foreground="{StaticResource DangerBrush}" Margin="0,1,6,0" VerticalAlignment="Top" />
            <TextBlock Text="{TemplateBinding Error}" Foreground="{StaticResource DangerBrush}" FontSize="13" TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
