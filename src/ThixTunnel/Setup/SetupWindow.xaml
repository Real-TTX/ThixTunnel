<Window x:Class="ThixTunnel.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ThixTunnel.Controls"
        Title="ThixTunnel Setup" Width="600" Height="540" MinWidth="380" MinHeight="400"
        Icon="/Assets/thixtunnel.ico" WindowStartupLocation="CenterScreen">
  <!-- The setup of ThixTunnel, after the Matgate agent / MatMon setup:
       Install: Welcome -> Progress -> Finish. Uninstall: Confirm -> Progress -> Finish. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="28,18">
      <StackPanel Orientation="Horizontal">
        <Image Source="/Assets/logo-256.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="26" FontWeight="SemiBold">
          <Run Text="Thix" /><Run Text="Tunnel" Foreground="{StaticResource AccentHoverBrush}" />
        </TextBlock>
        <TextBlock x:Name="ModeText" Margin="14,4,0,0" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Text="Setup" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="28,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Click="OnPrimaryClick" IsDefault="True">
            <controls:IconLabel x:Name="PrimaryLabel" Icon="{StaticResource IconDownload}" Text="Installieren" />
          </Button>
          <Button x:Name="CancelButton" Margin="8,0,0,0" Click="OnCancelClick" IsCancel="True">
            <controls:IconLabel Icon="{StaticResource IconBack}" Text="Abbrechen" />
          </Button>
        </StackPanel>
        <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="28,22,28,20">
        <!-- Install / update -->
        <StackPanel x:Name="WelcomePage">
          <TextBlock x:Name="WelcomeTitle" Text="Willkommen" Style="{StaticResource SectionTitle}" FontSize="20" />
          <TextBlock x:Name="WelcomeText" TextWrapping="Wrap" Margin="0,0,0,16"
                     Text="ThixTunnel verwaltet SSH-Profile und Tunnel über mehrere Hops und hält sie im Infobereich der Taskleiste verbunden." />
          <Border x:Name="OptionsTile" Style="{StaticResource Tile}" Padding="20,4">
            <StackPanel>
              <controls:SettingToggle x:Name="AutostartToggle" Title="Bei der Windows-Anmeldung starten" Description="Im Infobereich, ohne Fenster" IsChecked="True" />
              <controls:SettingToggle x:Name="DesktopToggle" Title="Verknüpfung auf dem Desktop" Description="Ein Startmenü-Eintrag wird immer angelegt" BorderThickness="0" />
            </StackPanel>
          </Border>
          <controls:InfoBar x:Name="PlaceInfo" />
          <controls:InfoBar x:Name="SshHint" />
        </StackPanel>

        <!-- Uninstall -->
        <StackPanel x:Name="ConfirmPage" Visibility="Collapsed">
          <TextBlock Text="ThixTunnel entfernen" Style="{StaticResource SectionTitle}" FontSize="20" />
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                     Text="Alle Tunnel werden getrennt. Programm, Startmenü-Eintrag, Desktop-Verknüpfung und Autostart werden entfernt." />
          <Border Style="{StaticResource Tile}" Padding="20,4">
            <controls:SettingToggle x:Name="DeleteDataToggle" Title="Auch meine Daten löschen" BorderThickness="0"
                                    Description="SSH-Profile, Verbindungen, Einstellungen und Protokolle. Ohne Haken bleiben sie für eine spätere Installation erhalten." />
          </Border>
        </StackPanel>

        <!-- Work in progress -->
        <StackPanel x:Name="ProgressPage" Visibility="Collapsed">
          <TextBlock x:Name="ProgressTitle" Text="Installiere …" Style="{StaticResource SectionTitle}" FontSize="20" />
          <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Margin="0,0,0,16"
                       Foreground="{StaticResource AccentBrush}" Background="{StaticResource InputBrush}" BorderThickness="0" />
          <ItemsControl x:Name="StepList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="{StaticResource IconCheck}" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Done -->
        <StackPanel x:Name="FinishPage" Visibility="Collapsed">
          <TextBlock x:Name="FinishTitle" Text="ThixTunnel ist bereit" Style="{StaticResource SectionTitle}" FontSize="20" />
          <controls:InfoBar x:Name="ResultBar" />
          <Border x:Name="StartTile" Style="{StaticResource Tile}" Padding="20,4">
            <controls:SettingToggle x:Name="StartToggle" Title="ThixTunnel jetzt starten" IsChecked="True" BorderThickness="0" />
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
