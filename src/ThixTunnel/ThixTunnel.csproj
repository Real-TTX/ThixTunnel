<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop application for Windows and macOS (Avalonia with MatDesktop, the desktop toolkit of MatDesign, copied
    into MatDesktop/): the main window, tray / menu bar icon and the SSH_ASKPASS helper (same program).
    Windows: published self-contained single-file for win-x64; that ThixTunnel.exe is its own setup (InstallService).
    macOS:   published self-contained for osx-arm64 / osx-x64 and packed into ThixTunnel.app (scripts/package-macos.sh).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ThixTunnel</AssemblyName>
    <RootNamespace>ThixTunnel</RootNamespace>
    <ApplicationIcon>Assets\thixtunnel.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>ThixTunnel</AssemblyTitle>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <!-- Bindings in data templates resolve by reflection (the rows are plain view models). -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- InstallService creates Windows shortcuts through the WScript.Shell COM object. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- Windows: one file, which is also the setup (App.RunSetupIfRequested). -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <PublishSingleFile>true</PublishSingleFile>
    <DefineConstants>$(DefineConstants);SINGLE_FILE</DefineConstants>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- macOS: the files go into ThixTunnel.app/Contents/MacOS (scripts/package-macos.sh). -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <!-- The snapshot command (Snapshot.cs) draws the windows without a screen. -->
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThixTunnel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThixTunnel.Core\ThixTunnel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\thixtunnel.ico" />
    <AvaloniaResource Include="Assets\logo-256.png" />
    <AvaloniaResource Include="Assets\tray-windows.png" />
    <AvaloniaResource Include="Assets\tray-macos.png" />
  </ItemGroup>

</Project>
