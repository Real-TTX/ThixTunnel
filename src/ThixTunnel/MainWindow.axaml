<mat:MatWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mat="using:MatDesktop"
               xmlns:controls="using:ThixTunnel.Controls"
               x:Class="ThixTunnel.MainWindow"
               Title="ThixTunnel" Width="1100" Height="720" MinWidth="760" MinHeight="460"
               WindowStartupLocation="CenterScreen">
  <!--
    The one window of ThixTunnel, in MatDesktop's chrome: the title bar (DESK-03: logo and word mark, the state of the tunnels
    and "Automatik pausieren" in the middle, the caption buttons / traffic lights), the menu (DESK-04: Verbindungen,
    Einstellungen below the line, the version = About at its foot, folds to a rail) and the page. Edit pages open inside
    it (Zurück / Esc go back). Built once; the tray, the Dock and a second start show it, the X hides it (DESK-06).
  -->
  <Grid RowDefinitions="Auto,*">
    <mat:MatTitleBar x:Name="TitleBar" AppName="ThixTunnel" CloseKey="Esc">
      <mat:MatTitleBar.WordMark>
        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Mat.FontSizeXl}" FontWeight="SemiBold">
          <Run Text="Thix" /><Run Text="Tunnel" Foreground="{DynamicResource Mat.AccentText}" />
        </TextBlock>
      </mat:MatTitleBar.WordMark>
      <mat:MatTitleBar.Center>
        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
          <Button x:Name="StateButton" Theme="{StaticResource MatButton.Ghost}" Click="OnStateClick" VerticalAlignment="Center"
                  ToolTip.Tip="Zu den Verbindungen">
            <mat:MatStateDot x:Name="StateDot" />
          </Button>
          <Button x:Name="PauseButton" Click="OnPauseClick" VerticalAlignment="Center">
            <controls:IconLabel x:Name="PauseLabel" Icon="pause" Text="Automatik pausieren" />
          </Button>
        </StackPanel>
      </mat:MatTitleBar.Center>
    </mat:MatTitleBar>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <mat:MatNav x:Name="Sidebar" AppName="ThixTunnel" />
      <ContentControl Grid.Column="1" x:Name="PageHost" />
    </Grid>
  </Grid>
</mat:MatWindow>
